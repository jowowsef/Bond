# Copy this file to ".env.local" and fill in YOUR values from:
# Supabase dashboard → Project Settings → API (or "Connect" button)
#
# The "anon"/"publishable" key is designed to be inside apps — it's safe
# because Row Level Security protects the data. NEVER put the
# "service_role"/"secret" key in the app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Google sign-in: the Google Cloud "Web" OAuth client ID (public, not a secret).
# Ends in .apps.googleusercontent.com. Leave empty to show Google as "not set up".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
