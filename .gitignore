# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# secrets and credentials (never commit; keep them outside the repo)
.env
.env.*
!.env.example
*.keystore
*.jks
credentials.json

# logs and memory dumps
*.log
*.hprof

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# phone diagnostic logs (contain personal device data)
bond-*.txt

# built apps (publish APKs through GitHub Releases, not the repo)
*.apk
*.aab

# Supabase CLI local cache
supabase/.temp/

# internal security notes (not for the public repo)
notes/SECURITY_AUDIT.md
notes/LAUNCH_CHECKLIST.md
