<?xml version="1.0" encoding="utf-8"?>
<!--
  Bond native module manifest. Android merges this into the app's final
  manifest automatically. Every permission here is explained in
  docs/PERMISSIONS.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!-- Read screen-time data. Only works after the owner turns on
       "Usage access" for Bond in Android Settings. -->
  <uses-permission
      android:name="android.permission.PACKAGE_USAGE_STATS"
      tools:ignore="ProtectedPermissions" />

  <!-- Re-start website protection after the phone reboots
       (only if it was already on). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Android 11+ hides other apps by default. We only need to see apps that
       appear in the launcher (to list them and show their names) and the
       home-screen apps (so we never block the launcher). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>

  <application>

    <!-- Website protection: a LOCAL VPN that only handles DNS lookups.
         Your internet traffic is NOT sent to any server of ours. Android
         shows a key icon in the status bar while it is on. -->
    <service
        android:name="com.bond.nativebridge.BondVpnService"
        android:exported="false"
        android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
    </service>

    <!-- App blocking: an Accessibility Service that ONLY looks at which app
         was opened (the package name). It cannot read screen content
         (canRetrieveWindowContent=false). The owner must turn it on
         manually in Settings → Accessibility. -->
    <service
        android:name="com.bond.nativebridge.BondAccessibilityService"
        android:exported="true"
        android:label="Bond app blocking"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/bond_accessibility_config" />
    </service>

    <!-- The friendly "this app is paused" screen. -->
    <activity
        android:name="com.bond.nativebridge.BlockedActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:launchMode="singleTask"
        android:taskAffinity="com.bond.blocked"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" />

    <receiver
        android:name="com.bond.nativebridge.BootReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
