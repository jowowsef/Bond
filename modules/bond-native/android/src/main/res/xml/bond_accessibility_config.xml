<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility configuration for Bond app blocking.
  - We ONLY listen for "a new window/app came to the front".
  - canRetrieveWindowContent="false": we cannot read text, passwords,
    messages or anything else on screen.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="200"
    android:description="@string/bond_accessibility_description" />
